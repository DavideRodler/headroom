# Copia questo file in .env e riempi i valori (Supabase > Project Settings > API)
VITE_SUPABASE_URL=
# Solo la chiave anon/publishable: MAI la service_role nel frontend
VITE_SUPABASE_ANON_KEY=
# Nome del bucket di Storage con le foto
VITE_SUPABASE_BUCKET=
# Cartella dentro il bucket (lascia vuoto se le foto sono nella radice)
VITE_SUPABASE_FOLDER=
